{
  "name": "flutter-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server agent tests *.json *.ts *.html *.yaml .github/workflows/*.yml README.md"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-mathematics": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-unique-id": "^3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ai": "^7.0.163",
    "dotenv": "^18.0.9",
    "eve": "1.0.0-rc.5",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@11.25.0"
